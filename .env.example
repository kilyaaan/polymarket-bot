# ── Wallet ────────────────────────────────────────────────────────────────────
# Clé privée du proxy wallet Polymarket (compte créé par email)
# polymarket.com → Profile → Settings → Export Private Key
PRIVATE_KEY=0x...

# Adresse publique du même wallet (optionnel, dérivée automatiquement si absent)
WALLET_ADDRESS=0x...

# Type de signature : 1 = proxy wallet email (défaut), 0 = MetaMask direct
CLOB_SIGNATURE_TYPE=1

# ── Polygon RPC ───────────────────────────────────────────────────────────────
# Nœud public par défaut. Remplace par Alchemy/Infura pour plus de fiabilité.
# Alchemy : https://polygon-mainnet.g.alchemy.com/v2/TON_API_KEY
POLYGON_RPC=https://polygon-bor-rpc.publicnode.com

# ── Telegram ──────────────────────────────────────────────────────────────────
# 1. Crée un bot via @BotFather → copie le token
# 2. Envoie un message à ton bot, puis ouvre :
#    https://api.telegram.org/bot<TON_TOKEN>/getUpdates
#    → récupère le "chat":{"id": ...}
TG_TOKEN=
TG_CHAT_ID=

# ── Discord ───────────────────────────────────────────────────────────────────
# Ton serveur Discord → Paramètres du salon → Intégrations → Webhooks → Nouveau webhook
# Copie l'URL du webhook ici
DISCORD_WEBHOOK=

# ── CLOB API credentials (optionnel) ─────────────────────────────────────────
# Laisse vide : le bot les dérive automatiquement depuis ta PRIVATE_KEY
# Remplis uniquement si tu veux forcer des creds existants
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=
